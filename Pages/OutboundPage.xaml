<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ClothingRecycler.Desktop.Pages.OutboundPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ClothingRecycler.Desktop.Models"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="出库工作台" />
            <TextBlock Style="{StaticResource MutedTextStyle}" Text="按“单分类出库”的业务方式展示全部类别。先看库存和计量方式，点开某个类别后再填写客户、出库量和出库单价。" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="今日出库金额" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{x:Bind ViewModel.TodayOutboundAmount, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="可出库分类数" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{x:Bind ViewModel.CategoryCountText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="最近记录数" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{x:Bind ViewModel.RecentRecordCountText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock
                HorizontalAlignment="Center"
                Opacity="0.72"
                Text="还没有任何分类。请先到设置页创建衣物分类后再做出库。"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}" />

            <Border Style="{StaticResource CardSurfaceStyle}" Visibility="{x:Bind ViewModel.FormVisibility, Mode=OneWay}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="按类别快捷出库" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="每次展开一个类别进行填写，更适合“一家只卖一种”的出库场景。" TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Click="OnRefreshClick"
                            Content="刷新分类"
                            VerticalAlignment="Top" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.CategoryEntries, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:OutboundCategoryDraftModel">
                                <Border Margin="0,0,0,12" Style="{StaticResource CardSurfaceStyle}">
                                    <StackPanel Spacing="12">
                                        <Button
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnCategoryEntryHeaderClick"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="0">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <TextBlock Style="{StaticResource ListTitleTextStyle}" Text="{x:Bind CategoryName}" />
                                                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="点击展开填写客户、数量和售价" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="当前库存" />
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind CurrentStockText}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Spacing="4">
                                                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="计量方式" />
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind UnitLabel}" />
                                                </StackPanel>

                                                <TextBlock
                                                    Grid.Column="3"
                                                    FontWeight="SemiBold"
                                                    Opacity="0.72"
                                                    Text="{x:Bind ExpandActionText, Mode=OneWay}"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>

                                        <StackPanel Spacing="12" Visibility="{x:Bind ExpandedVisibility, Mode=OneWay}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <ComboBox
                                                    Grid.Column="0"
                                                    DisplayMemberPath="DisplayName"
                                                    Header="已有客户（可选）"
                                                    ItemsSource="{Binding ElementName=RootPage, Path=ViewModel.Customers}"
                                                    PlaceholderText="不选则按匿名出库"
                                                    SelectedItem="{x:Bind SelectedCustomer, Mode=TwoWay}" />

                                                <TextBox
                                                    Grid.Column="1"
                                                    Header="新客户名称（可选）"
                                                    PlaceholderText="填写后会优先作为本次交易客户"
                                                    Text="{x:Bind NewCustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>

                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <NumberBox
                                                    Grid.Column="0"
                                                    Header="出库数量"
                                                    SmallChange="1"
                                                    Value="{x:Bind Quantity, Mode=TwoWay}" />

                                                <NumberBox
                                                    Grid.Column="1"
                                                    Header="出库单价"
                                                    Minimum="0.01"
                                                    SmallChange="1"
                                                    Value="{x:Bind UnitPrice, Mode=TwoWay}" />
                                            </Grid>

                                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="{x:Bind CustomerHintText, Mode=OneWay}" TextWrapping="WrapWholeWords" />

                                            <Border Style="{StaticResource SoftWarmPanelStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.2*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Spacing="6">
                                                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="实际出库客户" />
                                                        <TextBlock Style="{StaticResource DetailMetricValueTextStyle}" Text="{x:Bind EffectiveCustomerText, Mode=OneWay}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Spacing="6">
                                                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="建议售价" />
                                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind SuggestedPriceText, Mode=OneWay}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Spacing="6">
                                                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="本次总收入" />
                                                        <TextBlock Style="{StaticResource DetailMetricValueTextStyle}" Text="{x:Bind TotalRevenueText, Mode=OneWay}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="{x:Bind StockValidationText, Mode=OneWay}" TextWrapping="WrapWholeWords" />

                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <Button Click="OnEntrySubmitClick" Content="确认出库" IsEnabled="{x:Bind CanSubmit, Mode=OneWay}" />
                                                <Button Click="OnCategoryEntryHeaderClick" Content="收起" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardSurfaceStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="最近出库记录" />

                    <Grid ColumnSpacing="12" Padding="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderTextStyle}" Text="时间" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderTextStyle}" Text="客户" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderTextStyle}" Text="分类" />
                        <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderTextStyle}" Text="数量" />
                        <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderTextStyle}" Text="单价" />
                        <TextBlock Grid.Column="5" Style="{StaticResource TableHeaderTextStyle}" Text="总收入" />
                    </Grid>

                    <ListView
                        ItemsSource="{x:Bind ViewModel.RecentRecords, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:OutboundRecordModel">
                                <Grid ColumnSpacing="12" Padding="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind TimestampText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind CustomerDisplayName}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{x:Bind CategoryName}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind QuantityText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind UnitPriceText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind TotalRevenueText}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        HorizontalAlignment="Center"
                        Opacity="0.72"
                        Text="还没有出库记录。完成第一笔出库后会显示在这里。"
                        Visibility="{x:Bind ViewModel.RecentRecordsEmptyVisibility, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
