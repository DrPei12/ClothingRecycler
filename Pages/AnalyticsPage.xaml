<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ClothingRecycler.Desktop.Pages.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ClothingRecycler.Desktop.Models"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel MaxWidth="1680" Padding="32,28,32,40" Spacing="24">
            <Border Style="{StaticResource WorkbenchHeroSurfaceStyle}">
                <Grid>
                    <Border
                        Height="5"
                        VerticalAlignment="Top"
                        Background="{StaticResource BrandBrush}"
                        CornerRadius="28,28,0,0" />

                    <Grid Padding="28" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="14">
                            <TextBlock Style="{StaticResource WorkbenchEyebrowTextStyle}" Text="ANALYTICS" />
                            <TextBlock
                                Style="{StaticResource WorkbenchHeroTitleTextStyle}"
                                Text="把入库、出库、订单和客户放到同一张经营视图里，看清最近的走势和贡献来源。" />
                            <TextBlock
                                Style="{StaticResource WorkbenchSupportingTextStyle}"
                                Text="经营分析页保留趋势与排行两种视角：先看近七天走势，再往下看哪类货和哪些客户真正贡献了结果。" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Spacing="12">
                            <Border Style="{StaticResource WorkbenchMetricTileStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="累计入库金额" />
                                    <TextBlock Style="{StaticResource HeroMetricValueTextStyle}" Text="{x:Bind ViewModel.TotalInboundAmountText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Button Click="OnRefreshClick" Content="刷新数据" HorizontalAlignment="Right" MinWidth="120" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource WorkbenchMetricTileStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x7D2F;&#x8BA1;&#x5165;&#x5E93;&#x91D1;&#x989D;" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{x:Bind ViewModel.TotalInboundAmountText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource WorkbenchMetricTileStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x7D2F;&#x8BA1;&#x51FA;&#x5E93;&#x91D1;&#x989D;" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{x:Bind ViewModel.TotalOutboundAmountText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource WorkbenchMetricTileStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x4F30;&#x7B97;&#x6BDB;&#x5229;" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Foreground="{StaticResource BrandBrush}" Text="{x:Bind ViewModel.EstimatedMarginText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource WorkbenchMetricTileStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x6D3B;&#x8DC3;&#x5BA2;&#x6237;&#x6570;" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{x:Bind ViewModel.ActiveCustomerCountText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource WorkbenchMetricTileStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x603B;&#x8BA2;&#x5355;&#x6570;" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{x:Bind ViewModel.TotalOrderCountText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource WorkbenchCanvasSurfaceStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="&#x8FD1; 7 &#x5929;&#x7ECF;&#x8425;&#x8D70;&#x52BF;" />

                    <Grid ColumnSpacing="12" Padding="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderTextStyle}" Text="&#x65E5;&#x671F;" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderTextStyle}" Text="&#x5165;&#x5E93;&#x91D1;&#x989D;" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderTextStyle}" Text="&#x51FA;&#x5E93;&#x91D1;&#x989D;" />
                        <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderTextStyle}" Text="&#x4F30;&#x7B97;&#x6BDB;&#x5229;" />
                    </Grid>

                    <ListView
                        ItemsSource="{x:Bind ViewModel.DailyItems, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DailyAnalyticsItemModel">
                                <Grid ColumnSpacing="12" Padding="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{x:Bind DayText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind InboundAmountText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind OutboundAmountText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Foreground="{StaticResource BrandBrush}" Text="{x:Bind EstimatedMarginText}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        HorizontalAlignment="Center"
                        Opacity="0.72"
                        Text="&#x8FD8;&#x6CA1;&#x6709;&#x8DB3;&#x591F;&#x7684;&#x7ECF;&#x8425;&#x6570;&#x636E;&#x6765;&#x751F;&#x6210;&#x8D70;&#x52BF;&#x3002;"
                        Visibility="{x:Bind ViewModel.DailyEmptyVisibility, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource WorkbenchCanvasSurfaceStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="&#x5165;&#x5E93;&#x7C7B;&#x522B;&#x6392;&#x884C;" />
                        <ListView
                            ItemsSource="{x:Bind ViewModel.TopInboundCategories, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:CategoryAnalyticsItemModel">
                                    <Grid ColumnSpacing="12" Padding="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{x:Bind CategoryName}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind QuantityText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind AmountText}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            HorizontalAlignment="Center"
                            Opacity="0.72"
                            Text="&#x6682;&#x65E0;&#x5165;&#x5E93;&#x6570;&#x636E;&#x3002;"
                            Visibility="{x:Bind ViewModel.InboundRankingEmptyVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource WorkbenchCanvasSurfaceStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="&#x51FA;&#x5E93;&#x7C7B;&#x522B;&#x6392;&#x884C;" />
                        <ListView
                            ItemsSource="{x:Bind ViewModel.TopOutboundCategories, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:CategoryAnalyticsItemModel">
                                    <Grid ColumnSpacing="12" Padding="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{x:Bind CategoryName}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind QuantityText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Foreground="{StaticResource BrandBrush}" Text="{x:Bind AmountText}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            HorizontalAlignment="Center"
                            Opacity="0.72"
                            Text="&#x6682;&#x65E0;&#x51FA;&#x5E93;&#x6570;&#x636E;&#x3002;"
                            Visibility="{x:Bind ViewModel.OutboundRankingEmptyVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource WorkbenchCanvasSurfaceStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="&#x5BA2;&#x6237;&#x8D21;&#x732E;&#x6392;&#x884C;" />
                        <ListView
                            ItemsSource="{x:Bind ViewModel.TopCustomers, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:CustomerAnalyticsItemModel">
                                    <Grid ColumnSpacing="12" Padding="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind CustomerDisplayName}" />
                                            <TextBlock Opacity="0.72" Text="{x:Bind LastTransactionText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind OrderCountText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Foreground="{StaticResource BrandBrush}" Text="{x:Bind TotalAmountText}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            HorizontalAlignment="Center"
                            Opacity="0.72"
                            Text="&#x6682;&#x65E0;&#x5BA2;&#x6237;&#x7ECF;&#x8425;&#x8D21;&#x732E;&#x6570;&#x636E;&#x3002;"
                            Visibility="{x:Bind ViewModel.CustomerRankingEmptyVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
