<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ClothingRecycler.Desktop.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ClothingRecycler.Desktop.Models"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="&#x7ECF;&#x8425;&#x6982;&#x89C8;" />
            <TextBlock
                Style="{StaticResource MutedTextStyle}"
                Text="&#x672C;&#x5730;&#x684C;&#x9762;&#x7248;&#x7B2C;&#x4E00;&#x9636;&#x6BB5;&#x5DF2;&#x7ECF;&#x63A5;&#x5165;&#x4EEA;&#x8868;&#x76D8;&#x3001;&#x5165;&#x5E93;&#x3001;&#x5E93;&#x5B58;&#x548C;&#x5206;&#x7C7B;&#x7BA1;&#x7406;&#x3002;" />

            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x4ECA;&#x65E5;&#x5165;&#x5E93;&#x91D1;&#x989D;" />
                        <TextBlock FontSize="26" FontWeight="SemiBold" Text="{x:Bind ViewModel.TodayInboundAmount, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x4ECA;&#x65E5;&#x51FA;&#x5E93;&#x91D1;&#x989D;" />
                        <TextBlock FontSize="26" FontWeight="SemiBold" Text="{x:Bind ViewModel.TodayOutboundAmount, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x5F53;&#x524D;&#x5E93;&#x5B58;&#x6210;&#x672C;" />
                        <TextBlock FontSize="26" FontWeight="SemiBold" Text="{x:Bind ViewModel.TotalInventoryCost, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x5F53;&#x524D;&#x9884;&#x8BA1;&#x6536;&#x5165;" />
                        <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" Text="{x:Bind ViewModel.ForecastRevenue, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsQuickStartVisible, Mode=OneWay}"
                Message="&#x8FD8;&#x6CA1;&#x6709;&#x4EFB;&#x4F55;&#x5206;&#x7C7B;&#x3002;&#x8BF7;&#x5148;&#x524D;&#x5F80;&#x8BBE;&#x7F6E;&#x9875;&#x521B;&#x5EFA;&#x8863;&#x7269;&#x5206;&#x7C7B;&#x3002;"
                Severity="Informational" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="&#x9884;&#x8BA1;&#x6536;&#x5165;&#x6392;&#x884C;" />
                        <ListView
                            IsItemClickEnabled="False"
                            ItemsSource="{x:Bind ViewModel.TopCategories, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:CategoryModel">
                                    <Grid Padding="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Bind Name}" />
                                            <TextBlock Opacity="0.72" Text="{x:Bind DisplayStockText}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource BrandBrush}"
                                            Text="{x:Bind ForecastRevenueText}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource CardSurfaceStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="&#x5206;&#x7C7B;&#x603B;&#x6570;" />
                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="{x:Bind ViewModel.CategoryCount, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardSurfaceStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="&#x4F4E;&#x5E93;&#x5B58;&#x5206;&#x7C7B;" />
                            <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" Text="{x:Bind ViewModel.LowStockCount, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
