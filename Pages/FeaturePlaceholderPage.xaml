<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ClothingRecycler.Desktop.Pages.FeaturePlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="24">
        <Border
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource CardSurfaceStyle}"
            Width="560">
            <StackPanel Spacing="12">
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="{x:Bind TitleText, Mode=OneWay}" />
                <TextBlock Opacity="0.72" Text="{x:Bind DescriptionText, Mode=OneWay}" TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
