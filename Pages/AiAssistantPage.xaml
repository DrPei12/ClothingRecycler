<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ClothingRecycler.Desktop.Pages.AiAssistantPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ClothingRecycler.Desktop.Models"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="32,28,32,0"
            FontSize="40"
            FontWeight="SemiBold"
            Text="AI (Beta)" />

        <Grid
            Grid.Row="1"
            Margin="32,20,32,32"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.3*" />
                <ColumnDefinition Width="1.05*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Style="{StaticResource WorkbenchCanvasSurfaceStyle}">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="12">
                        <TextBlock
                            Style="{StaticResource WorkbenchSupportingTextStyle}"
                            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Click="OnUseQuickPromptClick" Tag="王姐入库夏装 12 斤，3 块 8" Content="入库示例：夏装 12 斤" />
                                <Button Click="OnUseQuickPromptClick" Tag="给李老板出库鞋子 3 件，单价 18" Content="出库示例：鞋子 3 件" />
                                <Button Click="OnUseQuickPromptClick" Tag="陈姐入库牛仔裤 8 公斤，单价 4.2" Content="入库示例：牛仔裤 8 公斤" />
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>

                    <ListView
                        x:Name="ConversationListView"
                        Grid.Row="1"
                        IsItemClickEnabled="False"
                        ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:AiConversationMessageModel">
                                <Grid Margin="0,0,0,14">
                                    <Border
                                        HorizontalAlignment="Right"
                                        Margin="96,0,0,0"
                                        Padding="16,14"
                                        Background="{StaticResource BrandBrush}"
                                        CornerRadius="22"
                                        Visibility="{x:Bind UserBubbleVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Text="{x:Bind Header}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
                                                    Text="{x:Bind TimestampText}" />
                                            </Grid>
                                            <TextBlock
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Text="{x:Bind Body}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        HorizontalAlignment="Left"
                                        Margin="0,0,96,0"
                                        Padding="16,14"
                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="22"
                                        Visibility="{x:Bind AssistantBubbleVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Header}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Opacity="0.62"
                                                    Text="{x:Bind TimestampText}" />
                                            </Grid>
                                            <TextBlock
                                                Text="{x:Bind Body}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Opacity="0.72"
                                                Text="{x:Bind SupportingText}"
                                                TextWrapping="WrapWholeWords"
                                                Visibility="{x:Bind SupportingTextVisibility, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border
                        Grid.Row="2"
                        Style="{StaticResource WorkbenchInsetPanelStyle}">
                        <StackPanel Spacing="12">
                            <TextBox
                                AcceptsReturn="True"
                                MinHeight="120"
                                PlaceholderText="直接输入自然语言，例如：王姐入库夏装 12 斤，3 块 8"
                                Text="{x:Bind ViewModel.PromptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource WorkbenchSupportingTextStyle}"
                                    Text="{x:Bind ViewModel.OperationGuidanceText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                                <Button
                                    Grid.Column="1"
                                    Click="OnVoiceInputClick"
                                    Content="{x:Bind ViewModel.VoiceButtonText, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanToggleVoiceRecording, Mode=OneWay}" />
                                <Button
                                    Grid.Column="2"
                                    Click="OnSendClick"
                                    Content="发送给 AI"
                                    IsEnabled="{x:Bind ViewModel.CanSend, Mode=OneWay}" />
                            </Grid>
                            <TextBlock
                                Style="{StaticResource WorkbenchSupportingTextStyle}"
                                Text="{x:Bind ViewModel.VoiceStatusText, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.VoiceStatusVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <StackPanel
                Grid.Column="1"
                Spacing="16">
                <Border Style="{StaticResource WorkbenchCanvasSurfaceStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource WorkbenchSectionCaptionTextStyle}" Text="CONTROL PANEL" />

                        <StackPanel Spacing="8" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="工作模式" />
                            <ComboBox
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{x:Bind ViewModel.OperationOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedOperationOption, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="本地 Provider" />
                            <ComboBox
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{x:Bind ViewModel.ProviderOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedProviderOption, Mode=TwoWay}" />
                        </StackPanel>

                        <Button Click="OnRefreshProviderClick" Content="刷新本地运行时状态" />

                        <Border Style="{StaticResource WorkbenchInsetPanelStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Provider 状态" />
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.ProviderStatusSummary, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource WorkbenchSupportingTextStyle}"
                                    Text="{x:Bind ViewModel.ProviderStatusDetail, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>

                        <TextBlock
                            Style="{StaticResource WorkbenchSupportingTextStyle}"
                            Text="AI 只会生成草稿，不会直接提交订单或改动库存。"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource WorkbenchCanvasSurfaceStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource WorkbenchSectionCaptionTextStyle}" Text="LATEST DRAFT" />
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{x:Bind ViewModel.LatestDraftTitle, Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.LatestDraftSummary, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Style="{StaticResource WorkbenchSupportingTextStyle}"
                            Text="{x:Bind ViewModel.CreateLatestOrderStatusText, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                        <Border
                            Style="{StaticResource SoftWarmPanelStyle}"
                            Visibility="{x:Bind ViewModel.LatestDraftVisibility, Mode=OneWay}">
                            <TextBlock
                                Text="{x:Bind ViewModel.LatestDraftWarnings, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />
                        </Border>
                        <StackPanel Spacing="10">
                            <Button
                                Click="OnCreateLatestOrderClick"
                                Content="{x:Bind ViewModel.CreateLatestOrderButtonText, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanCreateLatestOrder, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                Click="OnOpenLatestDraftClick"
                                Content="{x:Bind ViewModel.OpenLatestDraftButtonText, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.HasLatestDraft, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Style="{StaticResource WorkbenchCanvasSurfaceStyle}"
                    Visibility="{x:Bind ViewModel.AgentTraceVisibility, Mode=OneWay}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource WorkbenchSectionCaptionTextStyle}" Text="AGENT TRACE" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AgentTraceSteps, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AiWorkflowTraceStep">
                                    <Border
                                        Margin="0,0,0,10"
                                        Padding="12"
                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontWeight="SemiBold"
                                                    Opacity="0.62"
                                                    Text="{x:Bind StepLabel}" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind Title}" />
                                                    <TextBlock
                                                        Opacity="0.72"
                                                        Text="{x:Bind Status}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock
                                                FontSize="12"
                                                Opacity="0.78"
                                                Text="{x:Bind Detail}"
                                                TextWrapping="WrapWholeWords"
                                                Visibility="{x:Bind DetailVisibility, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
