<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ClothingRecycler.Desktop.Pages.InboundPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ClothingRecycler.Desktop.Models"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="&#x5165;&#x5E93;&#x5DE5;&#x4F5C;&#x53F0;" />
            <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x73B0;&#x5728;&#x5DF2;&#x63A5;&#x5165;&#x5206;&#x7C7B;&#x9009;&#x62E9;&#x3001;&#x5BA2;&#x6237;&#x8BC6;&#x522B;&#x3001;&#x4EF7;&#x683C;&#x8BB0;&#x5FC6;&#x3001;&#x5E93;&#x5B58;&#x5165;&#x8D26;&#x548C;&#x5165;&#x5E93;&#x8BB0;&#x5F55;&#x3002;" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x4ECA;&#x65E5;&#x5165;&#x5E93;&#x91D1;&#x989D;" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{x:Bind ViewModel.TodayInboundAmount, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x53EF;&#x5165;&#x5E93;&#x5206;&#x7C7B;&#x6570;" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{x:Bind ViewModel.CategoryCountText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x6700;&#x8FD1;&#x8BB0;&#x5F55;&#x6570;" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{x:Bind ViewModel.RecentRecordCountText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock
                HorizontalAlignment="Center"
                Opacity="0.72"
                Text="&#x8FD8;&#x6CA1;&#x6709;&#x4EFB;&#x4F55;&#x5206;&#x7C7B;&#x3002;&#x8BF7;&#x5148;&#x5230;&#x8BBE;&#x7F6E;&#x9875;&#x521B;&#x5EFA;&#x8863;&#x7269;&#x5206;&#x7C7B;&#x540E;&#x518D;&#x505A;&#x5165;&#x5E93;&#x3002;"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}" />

            <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.FormVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="&#x65B0;&#x5EFA;&#x5165;&#x5E93;&#x8BB0;&#x5F55;" />

                        <ComboBox
                            Header="&#x8863;&#x7269;&#x5206;&#x7C7B;"
                            DisplayMemberPath="Name"
                            ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Opacity="0.72" Text="&#x5F53;&#x524D;&#x5E93;&#x5B58;" />
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.CurrentStockText, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Opacity="0.72" Text="&#x8BA1;&#x91CF;&#x5355;&#x4F4D;" />
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.SelectedUnitText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ComboBox
                                Grid.Column="0"
                                Header="&#x5DF2;&#x6709;&#x5BA2;&#x6237;&#xFF08;&#x53EF;&#x9009;&#xFF09;"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{x:Bind ViewModel.Customers, Mode=OneWay}"
                                PlaceholderText="&#x4E0D;&#x9009;&#x5219;&#x6309;&#x533F;&#x540D;&#x5165;&#x5E93;"
                                SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}" />

                            <TextBox
                                Grid.Column="1"
                                Header="&#x65B0;&#x5BA2;&#x6237;&#x540D;&#x79F0;&#xFF08;&#x53EF;&#x9009;&#xFF09;"
                                PlaceholderText="&#x586B;&#x5199;&#x540E;&#x4F1A;&#x81EA;&#x52A8;&#x5EFA;&#x7ACB;&#x5BA2;&#x6237;"
                                Text="{x:Bind ViewModel.NewCustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <TextBlock Opacity="0.72" Text="&#x586B;&#x5199;&#x65B0;&#x5BA2;&#x6237;&#x540D;&#x79F0;&#x65F6;&#x4F1A;&#x4F18;&#x5148;&#x4F7F;&#x7528;&#x8BE5;&#x540D;&#x79F0;&#xFF1B;&#x5426;&#x5219;&#x4F7F;&#x7528;&#x5DF2;&#x9009;&#x5BA2;&#x6237;&#xFF1B;&#x90FD;&#x4E0D;&#x586B;&#x5219;&#x6309;&#x533F;&#x540D;&#x5165;&#x5E93;&#x3002;" TextWrapping="WrapWholeWords" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <NumberBox
                                Grid.Column="0"
                                Header="&#x5165;&#x5E93;&#x6570;&#x91CF;"
                                SmallChange="1"
                                Value="{x:Bind ViewModel.Quantity, Mode=TwoWay}" />

                            <NumberBox
                                Grid.Column="1"
                                Header="&#x5165;&#x5E93;&#x5355;&#x4EF7;"
                                Minimum="0.01"
                                SmallChange="1"
                                Value="{x:Bind ViewModel.UnitPrice, Mode=TwoWay}" />
                        </Grid>

                        <Border Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="12" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Opacity="0.72" Text="&#x672C;&#x6B21;&#x5165;&#x5E93;&#x603B;&#x6210;&#x672C;" />
                                <TextBlock Style="{StaticResource DetailMetricValueTextStyle}" Text="{x:Bind ViewModel.TotalCostText, Mode=OneWay}" />
                                <TextBlock Opacity="0.72" Text="&#x5F53;&#x524D;&#x5165;&#x5E93;&#x5BA2;&#x6237;&#xFF1A;" />
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.EffectiveCustomerText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Click="OnSubmitClick" Content="&#x786E;&#x8BA4;&#x5165;&#x5E93;" IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}" />
                            <Button Click="OnRefreshClick" Content="&#x5237;&#x65B0;" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource CardSurfaceStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="&#x5F53;&#x524D;&#x89C4;&#x5219;" />
                            <TextBlock Opacity="0.72" Text="1. &#x9009;&#x62E9;&#x5BA2;&#x6237;&#x540E;&#x4F1A;&#x4F18;&#x5148;&#x5E26;&#x51FA;&#x8BE5;&#x5BA2;&#x6237;&#x4E0A;&#x6B21;&#x5BF9;&#x5E94;&#x7C7B;&#x522B;&#x7684;&#x5165;&#x5E93;&#x5355;&#x4EF7;&#x3002;" TextWrapping="WrapWholeWords" />
                            <TextBlock Opacity="0.72" Text="2. &#x4FDD;&#x5B58;&#x540E;&#x4F1A;&#x7ACB;&#x5373;&#x5199;&#x5165;&#x5165;&#x5E93;&#x8BB0;&#x5F55;&#x3001;&#x521B;&#x5EFA;&#x5165;&#x5E93;&#x5355;&#x5E76;&#x540C;&#x6B65;&#x66F4;&#x65B0;&#x5E93;&#x5B58;&#x3002;" TextWrapping="WrapWholeWords" />
                            <TextBlock Opacity="0.72" Text="3. &#x4E0D;&#x586B;&#x5BA2;&#x6237;&#x65F6;&#x6309;&#x533F;&#x540D;&#x5165;&#x5E93;&#x5904;&#x7406;&#xFF1B;&#x586B;&#x5199;&#x65B0;&#x540D;&#x79F0;&#x4F1A;&#x81EA;&#x52A8;&#x5EFA;&#x7ACB;&#x5BA2;&#x6237;&#x3002;" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardSurfaceStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="&#x6700;&#x8FD1;&#x5165;&#x5E93;&#x8BB0;&#x5F55;" />

                    <Grid ColumnSpacing="12" Padding="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderTextStyle}" Text="&#x65F6;&#x95F4;" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderTextStyle}" Text="&#x5BA2;&#x6237;" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderTextStyle}" Text="&#x5206;&#x7C7B;" />
                        <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderTextStyle}" Text="&#x6570;&#x91CF;" />
                        <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderTextStyle}" Text="&#x5355;&#x4EF7;" />
                        <TextBlock Grid.Column="5" Style="{StaticResource TableHeaderTextStyle}" Text="&#x603B;&#x6210;&#x672C;" />
                    </Grid>

                    <ListView
                        ItemsSource="{x:Bind ViewModel.RecentRecords, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:InboundRecordModel">
                                <Grid ColumnSpacing="12" Padding="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind TimestampText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind CustomerDisplayName}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{x:Bind CategoryName}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind QuantityText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind UnitPriceText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind TotalCostText}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        HorizontalAlignment="Center"
                        Opacity="0.72"
                        Text="&#x8FD8;&#x6CA1;&#x6709;&#x5165;&#x5E93;&#x8BB0;&#x5F55;&#x3002;&#x5B8C;&#x6210;&#x7B2C;&#x4E00;&#x7B14;&#x5165;&#x5E93;&#x540E;&#x4F1A;&#x663E;&#x793A;&#x5728;&#x8FD9;&#x91CC;&#x3002;"
                        Visibility="{x:Bind ViewModel.RecentRecordsEmptyVisibility, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
