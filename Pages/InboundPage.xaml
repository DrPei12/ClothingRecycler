<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ClothingRecycler.Desktop.Pages.InboundPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ClothingRecycler.Desktop.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="InboundHeroSurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorAltBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="InboundCanvasSurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <Style x:Key="InboundInsetPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorAltBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="InboundMetricTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorAltBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="InboundEyebrowTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
            <Setter Property="CharacterSpacing" Value="120" />
        </Style>

        <Style x:Key="InboundHeroTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="InboundSupportingTextStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="InboundSectionCaptionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.62" />
            <Setter Property="CharacterSpacing" Value="60" />
        </Style>

        <Style x:Key="InboundInlineFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="InboundEntryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorAltBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="InboundRecordCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorAltBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="InboundHelpBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{ThemeResource LayerFillColorAltBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid
        Background="Transparent"
        PointerPressed="OnInteractionSurfacePointerPressed">
        <TextBox
            x:Name="PointerDismissFocusTarget"
            Width="1"
            Height="1"
            Margin="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsSpellCheckEnabled="False"
            Opacity="0"
            IsHitTestVisible="False" />

        <ScrollViewer>
            <StackPanel MaxWidth="1680" Padding="32,28,32,40" Spacing="24">
            <Border Style="{StaticResource InboundHeroSurfaceStyle}">
                <Grid>
                    <Border
                        Height="5"
                        VerticalAlignment="Top"
                        Background="{StaticResource BrandBrush}"
                        CornerRadius="28,28,0,0" />

                    <Grid Padding="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.1*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="14">
                            <TextBlock Style="{StaticResource InboundEyebrowTextStyle}" Text="INBOUND WORKSPACE" />
                            <TextBlock Style="{StaticResource InboundHeroTitleTextStyle}" Text="&#x5148;&#x9501;&#x5B9A;&#x5BA2;&#x6237;&#xFF0C;&#x518D;&#x628A;&#x8FD9;&#x6B21;&#x5165;&#x5E93;&#x4E00;&#x6B21;&#x5F55;&#x5B8C;&#x6574;&#x3002;" />
                            <TextBlock
                                Style="{StaticResource InboundSupportingTextStyle}"
                                Text="&#x8FD9;&#x4E00;&#x9875;&#x53EA;&#x505A;&#x4E00;&#x4EF6;&#x4E8B;&#xFF1A;&#x628A;&#x672C;&#x6B21;&#x5BA2;&#x6237;&#x5165;&#x5E93;&#x5F55;&#x6E05;&#x695A;&#xFF0C;&#x5E76;&#x5728;&#x6B63;&#x5F0F;&#x5199;&#x5165;&#x524D;&#x751F;&#x6210;&#x4E00;&#x5F20;&#x53EF;&#x76F4;&#x63A5;&#x53D1;&#x7ED9;&#x5BA2;&#x6237;&#x786E;&#x8BA4;&#x7684;&#x5165;&#x5E93;&#x5355;&#x3002;" />

                            <Grid ColumnSpacing="12" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource InboundInsetPanelStyle}" Padding="12,10">
                                    <TextBlock Text="&#x5148;&#x5B9A;&#x5BA2;&#x6237;&#xFF0C;&#x518D;&#x5F55;&#x5206;&#x7C7B;" />
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource InboundInsetPanelStyle}" Padding="12,10">
                                    <TextBlock Text="&#x5F55;&#x5355;&#x5355;&#x4F4D;&#x53EF;&#x5207;&#x6362;" />
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource InboundInsetPanelStyle}" Padding="12,10">
                                    <TextBlock Text="&#x786E;&#x8BA4;&#x540E;&#x624D;&#x6B63;&#x5F0F;&#x5165;&#x5E93;" />
                                </Border>
                            </Grid>
                        </StackPanel>

                        <Grid
                            Grid.Column="1"
                            ColumnSpacing="12"
                            RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource InboundMetricTileStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x4ECA;&#x65E5;&#x5165;&#x5E93;&#x91D1;&#x989D;" />
                                    <TextBlock Style="{StaticResource HeroMetricValueTextStyle}" Text="{x:Bind ViewModel.TodayInboundAmount, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource InboundMetricTileStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x53EF;&#x5165;&#x5E93;&#x5206;&#x7C7B;&#x6570;" />
                                    <TextBlock Style="{StaticResource HeroMetricValueTextStyle}" Text="{x:Bind ViewModel.CategoryCountText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource InboundMetricTileStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x6700;&#x8FD1;&#x8BB0;&#x5F55;&#x6570;" />
                                    <TextBlock Style="{StaticResource HeroMetricValueTextStyle}" Text="{x:Bind ViewModel.RecentRecordCountText, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource InboundSupportingTextStyle}" Text="&#x5F55;&#x5355;&#x5B8C;&#x6210;&#x540E;&#xFF0C;&#x6700;&#x65B0;&#x5165;&#x5E93;&#x4F1A;&#x76F4;&#x63A5;&#x56DE;&#x5230;&#x4E0B;&#x65B9;&#x8BB0;&#x5F55;&#x533A;&#xFF0C;&#x65B9;&#x4FBF;&#x9A6C;&#x4E0A;&#x590D;&#x6838;&#x3002;" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border
                Style="{StaticResource InboundCanvasSurfaceStyle}"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="520" Spacing="12">
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource SectionTitleTextStyle}" Text="&#x8FD8;&#x6CA1;&#x6709;&#x4EFB;&#x4F55;&#x53EF;&#x5165;&#x5E93;&#x5206;&#x7C7B;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource InboundSupportingTextStyle}"
                        Text="&#x8BF7;&#x5148;&#x53BB;&#x8BBE;&#x7F6E;&#x9875;&#x521B;&#x5EFA;&#x8863;&#x7269;&#x5206;&#x7C7B;&#x3002;&#x5206;&#x7C7B;&#x3001;&#x9ED8;&#x8BA4;&#x8BA1;&#x91CF;&#x65B9;&#x5F0F;&#x548C;&#x4E70;&#x5356;&#x4EF7;&#x51C6;&#x5907;&#x597D;&#x540E;&#xFF0C;&#x518D;&#x56DE;&#x6765;&#x5F00;&#x59CB;&#x5F55;&#x5165;&#x5165;&#x5E93;&#x8BA2;&#x5355;&#x3002;"
                        TextAlignment="Center" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.FormVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource InboundCanvasSurfaceStyle}">
                    <StackPanel Spacing="22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource InboundSectionCaptionTextStyle}" Text="CURRENT ORDER" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionTitleTextStyle}" Text="&#x672C;&#x6B21;&#x5BA2;&#x6237;&#x5165;&#x5E93;" />

                                    <Border
                                        Grid.Column="1"
                                        Style="{StaticResource InboundHelpBadgeStyle}"
                                        ToolTipService.ToolTip="&#x5148;&#x9009;&#x5B9A;&#x5BA2;&#x6237;&#xFF0C;&#x518D;&#x5F55;&#x5206;&#x7C7B;&#x3001;&#x6570;&#x91CF;&#x548C;&#x5355;&#x4EF7;&#x3002;&#x70B9;&#x51FB;&#x201C;&#x8FDB;&#x5165;&#x786E;&#x8BA4;&#x5355;&#x201D;&#x540E;&#x8FD8;&#x4E0D;&#x4F1A;&#x76F4;&#x63A5;&#x843D;&#x5E93;&#xFF0C;&#x9700;&#x5728;&#x786E;&#x8BA4;&#x7A97;&#x518D;&#x6B21;&#x786E;&#x8BA4;&#x3002;">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Opacity="0.72"
                                            Text="?" />
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Style="{StaticResource InboundInsetPanelStyle}"
                                Padding="14,12">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x5F53;&#x524D;&#x4EA4;&#x6613;&#x5BA2;&#x6237;" />
                                    <TextBlock Style="{StaticResource DetailMetricValueTextStyle}" Text="{x:Bind ViewModel.EffectiveCustomerText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource InboundInsetPanelStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{StaticResource InboundSectionCaptionTextStyle}" Text="&#x5DF2;&#x6709;&#x5BA2;&#x6237;" />
                                    <ComboBox
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{x:Bind ViewModel.Customers, Mode=OneWay}"
                                        PlaceholderText="&#x9009;&#x62E9;&#x672C;&#x6B21;&#x5165;&#x5E93;&#x5BA2;&#x6237;"
                                        SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource InboundInsetPanelStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{StaticResource InboundSectionCaptionTextStyle}" Text="&#x65B0;&#x5BA2;&#x6237;&#x540D;&#x79F0;" />
                                    <TextBox
                                        PlaceholderText="&#x586B;&#x5199;&#x540E;&#x4F1A;&#x4F18;&#x5148;&#x4F5C;&#x4E3A;&#x672C;&#x6B21;&#x4EA4;&#x6613;&#x5BA2;&#x6237;"
                                        Text="{x:Bind ViewModel.NewCustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border
                            Style="{StaticResource InboundInsetPanelStyle}"
                            Visibility="{x:Bind ViewModel.CustomerPromptVisibility, Mode=OneWay}">
                            <TextBlock
                                Style="{StaticResource InboundSupportingTextStyle}"
                                Text="&#x8BF7;&#x5148;&#x9009;&#x62E9;&#x6216;&#x65B0;&#x5EFA;&#x5BA2;&#x6237;&#xFF0C;&#x518D;&#x5F00;&#x59CB;&#x5F55;&#x5165;&#x5206;&#x7C7B;&#x660E;&#x7EC6;&#x3002;" />
                        </Border>

                        <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.EntryPanelVisibility, Mode=OneWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource InboundSectionCaptionTextStyle}" Text="CATEGORY LINES" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Style="{StaticResource ListTitleTextStyle}" Text="&#x5206;&#x7C7B;&#x5F55;&#x5355;&#x533A;" />

                                        <Border
                                            Grid.Column="1"
                                            Style="{StaticResource InboundHelpBadgeStyle}"
                                            ToolTipService.ToolTip="&#x9ED8;&#x8BA4;&#x5148;&#x5F55;&#x7B2C;&#x4E00;&#x6761;&#xFF0C;&#x786E;&#x8BA4;&#x5B8C;&#x518D;&#x70B9;&#x201C;&#x65B0;&#x589E;&#x5206;&#x7C7B;&#x201D;&#x3002;&#x9009;&#x5B9A;&#x5206;&#x7C7B;&#x540E;&#x4F1A;&#x5E26;&#x51FA;&#x5EFA;&#x8BAE;&#x5355;&#x4EF7;&#x548C;&#x5E93;&#x5B58;&#x4FE1;&#x606F;&#x3002;">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Opacity="0.72"
                                                Text="?" />
                                        </Border>
                                    </Grid>
                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    Click="OnAddCategoryEntryClick"
                                    Content="&#x65B0;&#x589E;&#x5206;&#x7C7B;"
                                    IsEnabled="{x:Bind ViewModel.CanAddCategoryEntry, Mode=OneWay}" />
                            </Grid>

                            <ListView
                                ItemsSource="{x:Bind ViewModel.CategoryEntries, Mode=OneWay}"
                                MaxHeight="560"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:InboundOrderDraftLineModel">
                                        <Border Style="{StaticResource InboundEntryCardStyle}">
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.4*" />
                                                    <ColumnDefinition Width="0.95*" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Spacing="8">
                                                    <TextBlock Style="{StaticResource InboundSectionCaptionTextStyle}" Text="&#x5206;&#x7C7B;&#x4E0E;&#x5E93;&#x5B58;" />
                                                    <ComboBox
                                                        DisplayMemberPath="Name"
                                                        ItemsSource="{x:Bind AvailableCategories, Mode=OneWay}"
                                                        PlaceholderText="&#x9009;&#x62E9;&#x5165;&#x5E93;&#x5206;&#x7C7B;"
                                                        SelectedItem="{x:Bind SelectedCategory, Mode=TwoWay}" />
                                                    <TextBlock Style="{StaticResource InboundSupportingTextStyle}" Text="{x:Bind CurrentStockText}" />
                                                    <TextBlock Style="{StaticResource InboundSupportingTextStyle}" Text="{x:Bind SuggestedPriceText, Mode=OneWay}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Spacing="8">
                                                    <TextBlock Style="{StaticResource InboundSectionCaptionTextStyle}" Text="&#x672C;&#x6B21;&#x5355;&#x4F4D;" />
                                                    <ComboBox
                                                        IsEnabled="{x:Bind HasSelectedCategory, Mode=OneWay}"
                                                        DisplayMemberPath="DisplayName"
                                                        ItemsSource="{x:Bind InputUnitOptions, Mode=OneWay}"
                                                        SelectedItem="{x:Bind SelectedInputUnitOption, Mode=TwoWay}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Spacing="0">
                                                    <TextBlock Style="{StaticResource InboundInlineFieldLabelStyle}" Text="&#x5165;&#x5E93;&#x6570;&#x91CF;" />
                                                    <NumberBox
                                                        Height="44"
                                                        HorizontalAlignment="Stretch"
                                                        IsEnabled="{x:Bind HasSelectedCategory, Mode=OneWay}"
                                                        SmallChange="1"
                                                        SpinButtonPlacementMode="Compact"
                                                        Value="{x:Bind Quantity, Mode=TwoWay}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" Spacing="0">
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Style="{StaticResource InboundInlineFieldLabelStyle}" Text="&#x5165;&#x5E93;&#x5355;&#x4EF7;" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="6,0,0,8"
                                                            Opacity="0.62"
                                                            Text="{x:Bind UnitLabel, Mode=OneWay}" />
                                                    </Grid>
                                                    <NumberBox
                                                        Height="44"
                                                        HorizontalAlignment="Stretch"
                                                        IsEnabled="{x:Bind HasSelectedCategory, Mode=OneWay}"
                                                        Minimum="0"
                                                        SmallChange="1"
                                                        SpinButtonPlacementMode="Compact"
                                                        Value="{x:Bind UnitPrice, Mode=TwoWay}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="4" MinWidth="104" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource InboundSectionCaptionTextStyle}" Text="&#x5C0F;&#x8BA1;" />
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind LineAmountText, Mode=OneWay}" />
                                                        <TextBlock
                                                            VerticalAlignment="Bottom"
                                                            FontSize="15"
                                                            FontWeight="SemiBold"
                                                            Opacity="0.68"
                                                            Text="{x:Bind QuantityText, Mode=OneWay}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <Button
                                                    Grid.Column="5"
                                                    VerticalAlignment="Center"
                                                    Click="OnRemoveCategoryEntryClick"
                                                    Content="&#x5220;&#x9664;"
                                                    Tag="{x:Bind}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource InboundSupportingTextStyle}"
                                    Text="&#x786E;&#x8BA4;&#x5F53;&#x524D;&#x5206;&#x7C7B;&#x5F55;&#x5B8C;&#x6574;&#x540E;&#xFF0C;&#x518D;&#x7EE7;&#x7EED;&#x65B0;&#x589E;&#x4E0B;&#x4E00;&#x6761;&#x3002;" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                    <Button Click="OnRefreshClick" Content="&#x5237;&#x65B0;" />
                                    <Button Click="OnSubmitClick" Content="&#x8FDB;&#x5165;&#x786E;&#x8BA4;&#x5355;" IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource InboundCanvasSurfaceStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource InboundSectionCaptionTextStyle}" Text="LIVE SUMMARY" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionTitleTextStyle}" Text="&#x5373;&#x65F6;&#x6458;&#x8981;" />

                                    <Border
                                        Grid.Column="1"
                                        Style="{StaticResource InboundHelpBadgeStyle}"
                                        ToolTipService.ToolTip="&#x53F3;&#x4FA7;&#x53EA;&#x770B;&#x7ED3;&#x679C;&#xFF0C;&#x4E0D;&#x5728;&#x8FD9;&#x91CC;&#x4FEE;&#x6570;&#x636E;&#x3002;&#x5982;&#x679C;&#x8981;&#x6539;&#x6570;&#x91CF;&#x6216;&#x5355;&#x4EF7;&#xFF0C;&#x8BF7;&#x56DE;&#x5230;&#x5DE6;&#x4FA7;&#x5F55;&#x5355;&#x533A;&#x3002;">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Opacity="0.72"
                                            Text="?" />
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource InboundMetricTileStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x4EA4;&#x6613;&#x5BA2;&#x6237;" />
                                        <TextBlock Style="{StaticResource DetailMetricValueTextStyle}" Text="{x:Bind ViewModel.EffectiveCustomerText, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource InboundMetricTileStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x5DF2;&#x586B;&#x5206;&#x7C7B;" />
                                        <TextBlock Style="{StaticResource DetailMetricValueTextStyle}" Text="{x:Bind ViewModel.FilledCategoryCountText, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource InboundMetricTileStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x6570;&#x91CF;&#x6C47;&#x603B;" />
                                        <TextBlock Style="{StaticResource DetailMetricValueTextStyle}" Text="{x:Bind ViewModel.QuantitySummaryText, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InboundMetricTileStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x5165;&#x5E93;&#x603B;&#x6210;&#x672C;" />
                                        <TextBlock Style="{StaticResource DetailMetricValueTextStyle}" Text="{x:Bind ViewModel.TotalCostText, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource InboundCanvasSurfaceStyle}">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource InboundSectionCaptionTextStyle}" Text="RECENT RECORDS" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Style="{StaticResource SectionTitleTextStyle}" Text="&#x6700;&#x8FD1;&#x5165;&#x5E93;&#x8BB0;&#x5F55;" />

                                <Border
                                    Grid.Column="1"
                                    Style="{StaticResource InboundHelpBadgeStyle}"
                                    ToolTipService.ToolTip="&#x8FD9;&#x91CC;&#x663E;&#x793A;&#x6700;&#x8FD1;&#x7684;&#x5165;&#x5E93;&#x6D41;&#x6C34;&#xFF0C;&#x65B9;&#x4FBF;&#x5F55;&#x5B8C;&#x4E4B;&#x540E;&#x7ACB;&#x5373;&#x56DE;&#x770B;&#x590D;&#x6838;&#x3002;">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Opacity="0.72"
                                        Text="?" />
                                </Border>
                            </Grid>
                        </StackPanel>

                        <ToggleButton
                            x:Name="RecentRecordsToggleButton"
                            Grid.Column="1"
                            MinWidth="112"
                            Checked="OnRecentRecordsToggleChecked"
                            Unchecked="OnRecentRecordsToggleUnchecked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE70D;" />
                                <TextBlock Text="&#x5C55;&#x5F00;&#x8BB0;&#x5F55;" />
                            </StackPanel>
                        </ToggleButton>
                    </Grid>

                    <StackPanel
                        x:Name="RecentRecordsBody"
                        Spacing="16"
                        Visibility="Collapsed">
                        <ListView
                            ItemsSource="{x:Bind ViewModel.RecentRecords, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:InboundRecordModel">
                                    <Border Style="{StaticResource InboundRecordCardStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.05*" />
                                                <ColumnDefinition Width="1.05*" />
                                                <ColumnDefinition Width="1.45*" />
                                                <ColumnDefinition Width="0.95*" />
                                                <ColumnDefinition Width="0.95*" />
                                                <ColumnDefinition Width="0.95*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Style="{StaticResource InboundSectionCaptionTextStyle}" Text="&#x65F6;&#x95F4;" />
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind TimestampText}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Style="{StaticResource InboundSectionCaptionTextStyle}" Text="&#x5BA2;&#x6237;" />
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind CustomerDisplayName}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock Style="{StaticResource InboundSectionCaptionTextStyle}" Text="&#x5206;&#x7C7B;" />
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind CategoryName}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Spacing="4">
                                                <TextBlock Style="{StaticResource InboundSectionCaptionTextStyle}" Text="&#x6570;&#x91CF;" />
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind QuantityText}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="4" Spacing="4">
                                                <TextBlock Style="{StaticResource InboundSectionCaptionTextStyle}" Text="&#x5355;&#x4EF7;" />
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind UnitPriceText}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="5" Spacing="4">
                                                <TextBlock Style="{StaticResource InboundSectionCaptionTextStyle}" Text="&#x603B;&#x6210;&#x672C;" />
                                                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" Text="{x:Bind TotalCostText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource InboundSupportingTextStyle}"
                            Text="&#x8FD8;&#x6CA1;&#x6709;&#x5165;&#x5E93;&#x8BB0;&#x5F55;&#x3002;&#x5B8C;&#x6210;&#x7B2C;&#x4E00;&#x7B14;&#x5165;&#x5E93;&#x540E;&#xFF0C;&#x4F1A;&#x663E;&#x793A;&#x5728;&#x8FD9;&#x91CC;&#x3002;"
                            Visibility="{x:Bind ViewModel.RecentRecordsEmptyVisibility, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
