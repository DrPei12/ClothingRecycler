<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ClothingRecycler.Desktop.Pages.OrdersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ClothingRecycler.Desktop.Models"
    mc:Ignorable="d">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="&#x8BA2;&#x5355;&#x4E2D;&#x5FC3;" />
            <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x5DE6;&#x4FA7;&#x67E5;&#x770B;&#x8FD1;&#x671F;&#x8BA2;&#x5355;&#xFF0C;&#x53F3;&#x4FA7;&#x67E5;&#x770B;&#x8BE5;&#x8BA2;&#x5355;&#x7684;&#x6458;&#x8981;&#x548C;&#x5206;&#x7C7B;&#x660E;&#x7EC6;&#x3002;" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardSurfaceStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x8BA2;&#x5355;&#x603B;&#x6570;" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{x:Bind ViewModel.TotalOrderCountText, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardSurfaceStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x4ECA;&#x65E5;&#x8BA2;&#x5355;" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{x:Bind ViewModel.TodayOrderCountText, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardSurfaceStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x5165;&#x5E93;&#x5355;" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{x:Bind ViewModel.InboundOrderCountText, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource CardSurfaceStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x51FA;&#x5E93;&#x5355;" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Foreground="{StaticResource BrandBrush}" Text="{x:Bind ViewModel.OutboundOrderCountText, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardSurfaceStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource SectionTitleTextStyle}" Text="&#x6700;&#x8FD1;&#x8BA2;&#x5355;" VerticalAlignment="Center" />

                        <ComboBox
                            Grid.Column="1"
                            Header="&#x8BA2;&#x5355;&#x7C7B;&#x578B;"
                            HorizontalAlignment="Left"
                            ItemsSource="{x:Bind ViewModel.Filters, Mode=OneWay}"
                            MinWidth="180"
                            SelectionChanged="OnFilterSelectionChanged"
                            SelectedItem="{x:Bind ViewModel.SelectedFilter, Mode=TwoWay}" />

                        <CommandBar Grid.Column="2" DefaultLabelPosition="Right">
                            <AppBarButton Click="OnRefreshClick" Icon="Refresh" Label="&#x5237;&#x65B0;" />
                        </CommandBar>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListView
                            ItemsSource="{x:Bind ViewModel.Orders, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedOrder, Mode=TwoWay}"
                            SelectionChanged="OnOrderSelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:OrderListItemModel">
                                    <Grid ColumnSpacing="12" Padding="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind OrderNumber}" />
                                            <TextBlock Opacity="0.72" Text="{x:Bind TimestampText}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Foreground="{StaticResource BrandBrush}" Text="{x:Bind TotalAmountText}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            HorizontalAlignment="Center"
                            Opacity="0.72"
                            Text="&#x5F53;&#x524D;&#x8FD8;&#x6CA1;&#x6709;&#x8BA2;&#x5355;&#x3002;&#x5B8C;&#x6210;&#x5165;&#x5E93;&#x6216;&#x51FA;&#x5E93;&#x540E;&#x4F1A;&#x51FA;&#x73B0;&#x5728;&#x8FD9;&#x91CC;&#x3002;"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardSurfaceStyle}">
                    <Grid>
                        <Grid Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{x:Bind ViewModel.SelectedOrderNumberText, Mode=OneWay}" />
                                    <TextBlock Opacity="0.72" Text="&#x8BE5;&#x8BA2;&#x5355;&#x7684;&#x5BA2;&#x6237;&#x3001;&#x7C7B;&#x578B;&#x548C;&#x91D1;&#x989D;&#x6458;&#x8981;&#x3002;" />
                                </StackPanel>

                                <CommandBar Grid.Column="1" DefaultLabelPosition="Right">
                                    <AppBarButton Click="OnEditOrderClick" Icon="Edit" Label="&#x7F16;&#x8F91;&#x8BA2;&#x5355;" />
                                    <AppBarButton Click="OnDeleteOrderClick" Icon="Delete" Label="&#x5220;&#x9664;&#x8BA2;&#x5355;" />
                                </CommandBar>
                            </Grid>

                            <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Opacity="0.72" Text="&#x7C7B;&#x578B;" />
                                <TextBlock Style="{StaticResource DetailMetricValueTextStyle}" Text="{x:Bind ViewModel.SelectedOrderTypeText, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Opacity="0.72" Text="&#x5BA2;&#x6237;" />
                                <TextBlock Style="{StaticResource DetailMetricValueTextStyle}" Text="{x:Bind ViewModel.SelectedOrderCustomerText, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Opacity="0.72" Text="&#x91D1;&#x989D;" />
                                <TextBlock Style="{StaticResource DetailMetricValueTextStyle}" Foreground="{StaticResource BrandBrush}" Text="{x:Bind ViewModel.SelectedOrderAmountText, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Spacing="4">
                                    <TextBlock Opacity="0.72" Text="&#x603B;&#x6570;&#x91CF;" />
                                <TextBlock Style="{StaticResource DetailMetricValueTextStyle}" Text="{x:Bind ViewModel.SelectedOrderQuantityText, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4" Spacing="4">
                                    <TextBlock Opacity="0.72" Text="&#x65F6;&#x95F4;" />
                                <TextBlock Style="{StaticResource DetailMetricValueTextStyle}" Text="{x:Bind ViewModel.SelectedOrderTimestampText, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <TextBlock
                            HorizontalAlignment="Center"
                            Opacity="0.72"
                            Text="&#x8BF7;&#x5148;&#x4ECE;&#x5DE6;&#x4FA7;&#x9009;&#x62E9;&#x4E00;&#x7B14;&#x8BA2;&#x5355;&#x3002;"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.NoSelectionVisibility, Mode=OneWay}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardSurfaceStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleTextStyle}" Text="&#x5206;&#x7C7B;&#x660E;&#x7EC6;" />

                        <Grid Grid.Row="1">
                            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}">
                                <Grid ColumnSpacing="12" Padding="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderTextStyle}" Text="&#x5206;&#x7C7B;" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderTextStyle}" Text="&#x6570;&#x91CF;" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderTextStyle}" Text="&#x5355;&#x4EF7;" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderTextStyle}" Text="&#x5C0F;&#x8BA1;" />
                                </Grid>

                                <ListView
                                    ItemsSource="{x:Bind ViewModel.SelectedOrderItems, Mode=OneWay}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:OrderDetailItemModel">
                                            <Grid ColumnSpacing="12" Padding="0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{x:Bind CategoryName}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind QuantityText}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind UnitPriceText}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Foreground="{StaticResource BrandBrush}" Text="{x:Bind LineAmountText}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>

                            <TextBlock
                                HorizontalAlignment="Center"
                                Opacity="0.72"
                                Text="&#x8BE5;&#x8BA2;&#x5355;&#x6682;&#x65E0;&#x660E;&#x7EC6;&#x8BB0;&#x5F55;&#x3002;"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.SelectedOrderItemsEmptyVisibility, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
