<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ClothingRecycler.Desktop.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ClothingRecycler.Desktop.Models"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="&#x8BBE;&#x7F6E;" />
            <TextBlock
                Style="{StaticResource MutedTextStyle}"
                Text="&#x8FD9;&#x4E00;&#x9636;&#x6BB5;&#x91CD;&#x70B9;&#x7528;&#x4E8E;&#x7EF4;&#x62A4;&#x8863;&#x7269;&#x5206;&#x7C7B;&#x3001;&#x5F52;&#x6863;&#x4E0D;&#x518D;&#x65B0;&#x589E;&#x4F7F;&#x7528;&#x7684;&#x5206;&#x7C7B;&#xFF0C;&#x5E76;&#x67E5;&#x770B;&#x5F53;&#x524D;&#x672C;&#x5730;&#x6570;&#x636E;&#x5E93;&#x4FE1;&#x606F;&#x3002;" />

            <CommandBar>
                <AppBarButton Click="OnAddCategoryClick" Icon="Add" Label="&#x65B0;&#x589E;&#x5206;&#x7C7B;" />
                <AppBarButton Click="OnRefreshClick" Icon="Refresh" Label="&#x5237;&#x65B0;" />
            </CommandBar>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x542F;&#x7528;&#x4E2D;&#x5206;&#x7C7B;" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{x:Bind ViewModel.ActiveCategoryCountText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x5DF2;&#x5F52;&#x6863;&#x5206;&#x7C7B;" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{x:Bind ViewModel.ArchivedCategoryCountText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x4F4E;&#x5E93;&#x5B58;&#x5206;&#x7C7B;" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Foreground="{StaticResource DangerBrush}" Text="{x:Bind ViewModel.LowStockCategoryCountText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="&#x8863;&#x7269;&#x5206;&#x7C7B;&#x7BA1;&#x7406;" />

                        <ListView
                            ItemsSource="{x:Bind ViewModel.CategoryItems, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:CategoryManagementItemModel">
                                    <Grid ColumnSpacing="16" Opacity="{x:Bind ItemOpacity}" Padding="0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="8">
                                            <Grid RowSpacing="6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel
                                                    Grid.Row="0"
                                                    Orientation="Horizontal"
                                                    Spacing="10"
                                                    VerticalAlignment="Top">
                                                    <TextBlock Style="{StaticResource ListTitleTextStyle}" Text="{x:Bind Name}" VerticalAlignment="Center" />
                                                    <Border
                                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                        CornerRadius="999"
                                                        Padding="10,4"
                                                        VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource BadgeTextStyle}" Text="{x:Bind StatusText}" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock
                                                    Grid.Row="1"
                                                    Opacity="0.72"
                                                    Text="{x:Bind RecordSummaryText}"
                                                    TextWrapping="WrapWholeWords" />
                                            </Grid>

                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="&#x5355;&#x4F4D;" />
                                                    <TextBlock Text="{x:Bind UnitLabel}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="&#x6536;&#x8D2D;&#x4EF7;" />
                                                    <TextBlock Text="{x:Bind BuyPriceText}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Spacing="3">
                                                    <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="&#x5356;&#x4EF7;" />
                                                    <TextBlock Text="{x:Bind SellPriceText}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" Spacing="3">
                                                    <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="&#x5F53;&#x524D;&#x5E93;&#x5B58;" />
                                                    <TextBlock Text="{x:Bind DisplayStockText}" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Opacity="0.72" Text="{x:Bind QuantitySummaryText}" TextWrapping="WrapWholeWords" />
                                        </StackPanel>

                                        <CommandBar Grid.Column="1" DefaultLabelPosition="Right">
                                            <AppBarButton Click="OnEditCategoryClick" Icon="Edit" Label="&#x7F16;&#x8F91;" Tag="{x:Bind}" />
                                            <AppBarButton Click="OnArchiveCategoryClick" Icon="Sync" Label="{x:Bind ArchiveActionText}" Tag="{x:Bind}" />
                                            <AppBarButton Click="OnDeleteCategoryClick" Icon="Delete" Label="&#x5220;&#x9664;" Tag="{x:Bind}" />
                                        </CommandBar>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            HorizontalAlignment="Center"
                            Opacity="0.72"
                            Text="&#x8FD8;&#x6CA1;&#x6709;&#x4EFB;&#x4F55;&#x5206;&#x7C7B;&#x3002;&#x70B9;&#x51FB;&#x201C;&#x65B0;&#x589E;&#x5206;&#x7C7B;&#x201D;&#x5F00;&#x59CB;&#x914D;&#x7F6E;&#x3002;"
                            Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource CardSurfaceStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="&#x754C;&#x9762;&#x663E;&#x793A;" />
                            <TextBlock
                                Style="{StaticResource MutedTextStyle}"
                                Text="&#x8C03;&#x6574;&#x6574;&#x4F53;&#x6587;&#x5B57;&#x5927;&#x5C0F;&#xFF0C;&#x4FEE;&#x6539;&#x540E;&#x4F1A;&#x7ACB;&#x5373;&#x751F;&#x6548;&#x3002;"
                                TextWrapping="WrapWholeWords" />
                            <ComboBox
                                ItemsSource="{x:Bind ViewModel.FontSizeOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedFontSizeOption, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:FontSizeOptionModel">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind DisplayName}" />
                                            <TextBlock
                                                Style="{StaticResource MutedTextStyle}"
                                                Text="{x:Bind Description}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Opacity="0.72" Text="&#x754C;&#x9762;&#x504F;&#x597D;&#x6587;&#x4EF6;&#x8DEF;&#x5F84;" />
                            <TextBox IsReadOnly="True" Text="{x:Bind ViewModel.UiSettingsPath, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardSurfaceStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="&#x672C;&#x5730;&#x6570;&#x636E;&#x5E93;&#x6587;&#x4EF6;" />
                            <CommandBar DefaultLabelPosition="Right">
                                <AppBarButton Click="OnBackupDatabaseClick" Icon="SaveLocal" Label="&#x521B;&#x5EFA;&#x5907;&#x4EFD;" />
                                <AppBarButton Click="OnRestoreDatabaseClick" Icon="OpenFile" Label="&#x4ECE;&#x5907;&#x4EFD;&#x6062;&#x590D;" />
                                <AppBarButton Click="OnOpenBackupDirectoryClick" Icon="Folder" Label="&#x6253;&#x5F00;&#x5907;&#x4EFD;&#x76EE;&#x5F55;" />
                            </CommandBar>
                            <TextBlock Opacity="0.72" Text="&#x6570;&#x636E;&#x5E93;&#x8DEF;&#x5F84;" />
                            <TextBox IsReadOnly="True" Text="{x:Bind ViewModel.DatabasePath, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Opacity="0.72" Text="&#x5907;&#x4EFD;&#x76EE;&#x5F55;" />
                            <TextBox IsReadOnly="True" Text="{x:Bind ViewModel.BackupDirectory, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardSurfaceStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="&#x8BCA;&#x65AD;&#x4E0E;&#x8FC1;&#x79FB;" />
                            <CommandBar DefaultLabelPosition="Right">
                                <AppBarButton Click="OnRunConsistencyCheckClick" Icon="Find" Label="&#x8FD0;&#x884C;&#x4E00;&#x81F4;&#x6027;&#x68C0;&#x67E5;" />
                                <AppBarButton Click="OnOpenLogDirectoryClick" Icon="Folder" Label="&#x6253;&#x5F00;&#x65E5;&#x5FD7;&#x76EE;&#x5F55;" />
                            </CommandBar>
                            <TextBlock Opacity="0.72" Text="&#x5E94;&#x7528;&#x7248;&#x672C;" />
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{x:Bind ViewModel.AppVersionText, Mode=OneWay}" />
                            <TextBlock Opacity="0.72" Text="&#x5C01;&#x88C5;&#x65B9;&#x5F0F;" />
                            <TextBlock Text="{x:Bind ViewModel.PackagingText, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                            <TextBlock Opacity="0.72" Text="&#x6570;&#x636E;&#x5E93;&#x67B6;&#x6784;&#x7248;&#x672C;" />
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{x:Bind ViewModel.SchemaVersionText, Mode=OneWay}" />
                            <TextBlock Opacity="0.72" Text="&#x6700;&#x8FD1;&#x81EA;&#x68C0;&#x72B6;&#x6001;" />
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{x:Bind ViewModel.ConsistencyStatusText, Mode=OneWay}" />
                            <TextBlock Opacity="0.72" Text="&#x6700;&#x8FD1;&#x81EA;&#x68C0;&#x7ED3;&#x679C;" />
                            <TextBlock Text="{x:Bind ViewModel.LastConsistencyCheckText, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                            <TextBlock Opacity="0.72" Text="&#x5D29;&#x6E83;&#x4E0E;&#x8FD0;&#x884C;&#x65E5;&#x5FD7;&#x76EE;&#x5F55;" />
                            <TextBox IsReadOnly="True" Text="{x:Bind ViewModel.LogDirectory, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardSurfaceStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="&#x7ECF;&#x8425;&#x6570;&#x636E;&#x5BFC;&#x51FA;" />
                            <CommandBar DefaultLabelPosition="Right">
                                <AppBarButton Click="OnExportBusinessDataClick" Icon="Save" Label="&#x5BFC;&#x51FA; CSV" />
                                <AppBarButton Click="OnOpenExportDirectoryClick" Icon="Folder" Label="&#x6253;&#x5F00;&#x5BFC;&#x51FA;&#x76EE;&#x5F55;" />
                            </CommandBar>
                            <TextBlock Opacity="0.72" Text="&#x5BFC;&#x51FA;&#x76EE;&#x5F55;" />
                            <TextBox IsReadOnly="True" Text="{x:Bind ViewModel.ExportDirectory, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock
                                Opacity="0.72"
                                Text="&#x5C06;&#x5BFC;&#x51FA;&#x5206;&#x7C7B;&#x3001;&#x5BA2;&#x6237;&#x3001;&#x4EF7;&#x683C;&#x8BB0;&#x5FC6;&#x3001;&#x8BA2;&#x5355;&#x3001;&#x5165;&#x5E93;&#x3001;&#x51FA;&#x5E93;&#x3001;&#x5E93;&#x5B58;&#x8C03;&#x6574;&#x548C;&#x76D8;&#x70B9;&#x8BB0;&#x5F55;&#x3002;"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardSurfaceStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="&#x4E3B;&#x6570;&#x636E;&#x5BFC;&#x5165;" />
                            <CommandBar DefaultLabelPosition="Right">
                                <AppBarButton Click="OnImportCategoriesClick" Icon="Upload" Label="&#x5BFC;&#x5165;&#x5206;&#x7C7B; CSV" />
                                <AppBarButton Click="OnImportCustomersClick" Icon="Upload" Label="&#x5BFC;&#x5165;&#x5BA2;&#x6237; CSV" />
                            </CommandBar>
                            <TextBlock
                                Opacity="0.72"
                                Text="&#x652F;&#x6301;&#x5BFC;&#x5165;&#x5148;&#x524D;&#x5BFC;&#x51FA;&#x7684; categories.csv &#x548C; customers.csv&#x3002;&#x5BFC;&#x5165;&#x53EA;&#x5904;&#x7406;&#x5206;&#x7C7B;&#x3001;&#x5BA2;&#x6237;&#x4E3B;&#x6570;&#x636E;&#xFF0C;&#x4E0D;&#x4F1A;&#x8986;&#x76D6;&#x5DF2;&#x6709;&#x5E93;&#x5B58;&#x3001;&#x8BA2;&#x5355;&#x548C;&#x5386;&#x53F2;&#x6D41;&#x6C34;&#x3002;"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardSurfaceStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="&#x7EF4;&#x62A4;&#x89C4;&#x5219;" />
                            <TextBlock Opacity="0.72" Text="1. &#x201C;&#x5F52;&#x6863;&#x201D;&#x540E;&#x7684;&#x5206;&#x7C7B;&#x4E0D;&#x4F1A;&#x518D;&#x51FA;&#x73B0;&#x5728;&#x5165;&#x5E93;&#x3001;&#x51FA;&#x5E93;&#x7684;&#x65B0;&#x5EFA;&#x8868;&#x5355;&#x91CC;&#xFF0C;&#x4F46;&#x5386;&#x53F2;&#x6570;&#x636E;&#x4F1A;&#x4FDD;&#x7559;&#x3002;" TextWrapping="WrapWholeWords" />
                            <TextBlock Opacity="0.72" Text="2. &#x6709;&#x5E93;&#x5B58;&#x6216;&#x6709;&#x6D41;&#x6C34;&#x7684;&#x5206;&#x7C7B;&#x4E0D;&#x80FD;&#x76F4;&#x63A5;&#x5220;&#x9664;&#xFF0C;&#x907F;&#x514D;&#x7814;&#x7A76;&#x548C;&#x53F0;&#x8D26;&#x88AB;&#x7834;&#x574F;&#x3002;" TextWrapping="WrapWholeWords" />
                            <TextBlock Opacity="0.72" Text="3. &#x7F16;&#x8F91;&#x5206;&#x7C7B;&#x65F6;&#x4F1A;&#x4FDD;&#x7559;&#x73B0;&#x6709;&#x5E93;&#x5B58;&#x548C;&#x5F52;&#x6863;&#x72B6;&#x6001;&#x3002;" TextWrapping="WrapWholeWords" />
                            <TextBlock Opacity="0.72" Text="4. &#x6062;&#x590D;&#x5907;&#x4EFD;&#x524D;&#x4F1A;&#x5148;&#x81EA;&#x52A8;&#x521B;&#x5EFA;&#x4E00;&#x4EFD;&#x5F53;&#x524D;&#x6570;&#x636E;&#x7684;&#x6062;&#x590D;&#x70B9;&#xFF0C;&#x5E76;&#x5728;&#x6062;&#x590D;&#x540E;&#x91CD;&#x542F;&#x5E94;&#x7528;&#x3002;" TextWrapping="WrapWholeWords" />
                            <TextBlock Opacity="0.72" Text="5. CSV &#x5BFC;&#x51FA;&#x4F1A;&#x8F93;&#x51FA;&#x5F53;&#x524D;&#x53EF;&#x7528;&#x53F0;&#x8D26;&#x5FEB;&#x7167;&#xFF0C;&#x9002;&#x5408;&#x7ED9; Excel &#x6216;&#x5176;&#x4ED6;&#x7EDF;&#x8BA1;&#x5DE5;&#x5177;&#x7EE7;&#x7EED;&#x5904;&#x7406;&#x3002;" TextWrapping="WrapWholeWords" />
                            <TextBlock Opacity="0.72" Text="6. CSV &#x5BFC;&#x5165;&#x9ED8;&#x8BA4;&#x6309;&#x540D;&#x79F0;&#x5408;&#x5E76;&#x5206;&#x7C7B;&#x6216;&#x5BA2;&#x6237;&#x3002;&#x82E5;&#x540C;&#x540D;&#x5206;&#x7C7B;&#x7684;&#x5355;&#x4F4D;&#x4E0D;&#x4E00;&#x81F4;&#xFF0C;&#x5E94;&#x7528;&#x4F1A;&#x62E6;&#x622A;&#x5E76;&#x63D0;&#x793A;&#x624B;&#x52A8;&#x6838;&#x5BF9;&#x3002;" TextWrapping="WrapWholeWords" />
                            <TextBlock Opacity="0.72" Text="7. &#x5E94;&#x7528;&#x542F;&#x52A8;&#x65F6;&#x4F1A;&#x81EA;&#x52A8;&#x68C0;&#x67E5;&#x6570;&#x636E;&#x5E93;&#x67B6;&#x6784;&#x7248;&#x672C;&#x5E76;&#x6267;&#x884C;&#x5FC5;&#x8981;&#x8FC1;&#x79FB;&#xFF0C;&#x4E25;&#x91CD;&#x5F02;&#x5E38;&#x4F1A;&#x5199;&#x5165;&#x65E5;&#x5FD7;&#x76EE;&#x5F55;&#x3002;" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
