<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="ClothingRecycler.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="BrandColor">#1976D2</Color>
                    <Color x:Key="PositiveColor">#2E7D32</Color>
                    <Color x:Key="DangerColor">#C62828</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="BrandColor">#8AB4F8</Color>
                    <Color x:Key="PositiveColor">#81C995</Color>
                    <Color x:Key="DangerColor">#F28B82</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="BrandBrush" Color="{ThemeResource BrandColor}" />
            <SolidColorBrush x:Key="PositiveBrush" Color="{ThemeResource PositiveColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource DangerColor}" />

            <x:Double x:Key="AppBodyFontSize">14</x:Double>
            <x:Double x:Key="AppTableHeaderFontSize">12</x:Double>
            <x:Double x:Key="AppBadgeFontSize">12</x:Double>
            <x:Double x:Key="AppCompactListTitleFontSize">15</x:Double>
            <x:Double x:Key="AppListTitleFontSize">16</x:Double>
            <x:Double x:Key="AppSectionTitleFontSize">18</x:Double>
            <x:Double x:Key="AppPageTitleFontSize">28</x:Double>
            <x:Double x:Key="AppMetricFontSize">24</x:Double>
            <x:Double x:Key="AppHeroMetricFontSize">26</x:Double>
            <x:Double x:Key="AppDetailMetricFontSize">20</x:Double>

            <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="{ThemeResource AppBodyFontSize}" />
            </Style>

            <Style TargetType="Control">
                <Setter Property="FontSize" Value="{ThemeResource AppBodyFontSize}" />
            </Style>

            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{ThemeResource AppPageTitleFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{ThemeResource AppSectionTitleFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="CardSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{ThemeResource AppTableHeaderFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Opacity" Value="0.72" />
            </Style>

            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.72" />
            </Style>

            <Style x:Key="MetricValueTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{ThemeResource AppMetricFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="HeroMetricValueTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{ThemeResource AppHeroMetricFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="DetailMetricValueTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{ThemeResource AppDetailMetricFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="ListTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{ThemeResource AppListTitleFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="CompactListTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{ThemeResource AppCompactListTitleFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{ThemeResource AppBadgeFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
