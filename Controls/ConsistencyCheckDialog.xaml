<?xml version="1.0" encoding="UTF-8" ?>
<ContentDialog
    x:Class="ClothingRecycler.Desktop.Controls.ConsistencyCheckDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ClothingRecycler.Desktop.Models"
    mc:Ignorable="d"
    CloseButtonText="关闭"
    DefaultButton="Close">
    <ScrollViewer MaxHeight="680">
        <StackPanel Spacing="16">
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind Report.SummaryMessage, Mode=OneWay}"
                Severity="{x:Bind Report.SummarySeverity, Mode=OneWay}" />

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind Report.AutoRepairHintMessage, Mode=OneWay}"
                Severity="Informational"
                Visibility="{x:Bind AutoRepairHintVisibility, Mode=OneWay}" />

            <Border Style="{StaticResource CardSurfaceStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="检查概览" />
                    <TextBlock Opacity="0.72" Text="{x:Bind Report.GeneratedAtText, Mode=OneWay}" />

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                            <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="分类数" />
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind Report.CategoryCount, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3">
                            <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="客户数" />
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind Report.CustomerCount, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3">
                            <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="订单数" />
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind Report.OrderCount, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                            <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="问题数" />
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind Report.IssueCount, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardSurfaceStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="检查项目" />

                    <ListView ItemsSource="{x:Bind Report.CheckItems, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ConsistencyCheckItemModel">
                                <Grid ColumnSpacing="12" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                        <TextBlock Opacity="0.72" Text="{x:Bind DetailText}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="999" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" Text="{x:Bind StatusText}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardSurfaceStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="问题明细" />

                    <ListView
                        ItemsSource="{x:Bind Report.Issues, Mode=OneWay}"
                        MaxHeight="260"
                        SelectionMode="None"
                        Visibility="{x:Bind Report.IssuesVisibility, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ConsistencyCheckIssueModel">
                                <Grid ColumnSpacing="12" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource DangerBrush}" CornerRadius="999" Padding="10,4" VerticalAlignment="Top">
                                        <TextBlock Foreground="White" FontSize="12" Text="{x:Bind SeverityText}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                        <TextBlock Opacity="0.72" Text="{x:Bind CheckName}" />
                                        <TextBlock Text="{x:Bind DetailText}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        HorizontalAlignment="Center"
                        Opacity="0.72"
                        Text="当前没有发现账本一致性问题。"
                        Visibility="{x:Bind Report.EmptyIssuesVisibility, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
