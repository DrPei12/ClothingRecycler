<?xml version="1.0" encoding="UTF-8" ?>
<ContentDialog
    x:Class="ClothingRecycler.Desktop.Controls.CategoryEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    CloseButtonText="&#x53D6;&#x6D88;"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="&#x4FDD;&#x5B58;">
    <StackPanel Spacing="12">
        <InfoBar
            x:Name="ValidationInfoBar"
            IsClosable="False"
            IsOpen="False"
            Severity="Error" />

        <TextBox x:Name="NameTextBox" Header="&#x5206;&#x7C7B;&#x540D;&#x79F0;" PlaceholderText="&#x4F8B;&#x5982;&#xFF1A;&#x7FBD;&#x7ED2;&#x670D;" />

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <NumberBox
                x:Name="BuyPriceBox"
                Grid.Column="0"
                Header="&#x6536;&#x8D2D;&#x4EF7;"
                Minimum="0.01"
                SmallChange="1" />
            <NumberBox
                x:Name="SellPriceBox"
                Grid.Column="1"
                Header="&#x5356;&#x4EF7;"
                Minimum="0.01"
                SmallChange="1" />
        </Grid>

        <ComboBox x:Name="UnitComboBox" Header="&#x8BA1;&#x91CF;&#x5355;&#x4F4D;">
            <ComboBoxItem Content="&#x516C;&#x65A4; (kg)" Tag="Kilogram" />
            <ComboBoxItem Content="&#x65A4;" Tag="Jin" />
            <ComboBoxItem Content="&#x4EF6;" Tag="Piece" />
        </ComboBox>

        <StackPanel x:Name="InitialStockPanel" Spacing="4">
            <NumberBox
                x:Name="InitialStockBox"
                Header="&#x521D;&#x59CB;&#x5E93;&#x5B58;"
                Minimum="0"
                SmallChange="1" />
            <TextBlock Opacity="0.72" Text="&#x53EA;&#x6709;&#x65B0;&#x5EFA;&#x5206;&#x7C7B;&#x65F6;&#x53EF;&#x4EE5;&#x8BBE;&#x7F6E;&#x521D;&#x59CB;&#x5E93;&#x5B58;&#x3002;" />
        </StackPanel>

        <StackPanel x:Name="CurrentStockPanel" Spacing="4" Visibility="Collapsed">
            <TextBlock Opacity="0.72" Text="&#x5F53;&#x524D;&#x5E93;&#x5B58;" />
            <TextBlock x:Name="CurrentStockTextBlock" FontWeight="SemiBold" />
            <TextBlock
                Opacity="0.72"
                Text="&#x5DF2;&#x6709;&#x5E93;&#x5B58;&#x65F6;&#x4E0D;&#x5141;&#x8BB8;&#x4FEE;&#x6539;&#x8BA1;&#x91CF;&#x5355;&#x4F4D;&#xFF0C;&#x907F;&#x514D;&#x5F71;&#x54CD;&#x5386;&#x53F2;&#x5E93;&#x5B58;&#x6570;&#x636E;&#x3002;"
                TextWrapping="WrapWholeWords" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
