<?xml version="1.0" encoding="UTF-8" ?>
<Window
    x:Class="ClothingRecycler.Desktop.FormulaWindows.ForecastFormulaWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid
        x:Name="RootLayout"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <Grid
                x:Name="DocumentRoot"
                MaxWidth="1440"
                Padding="36"
                RowSpacing="20"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="预计收入计算公式" />
                    <TextBlock
                        Opacity="0.72"
                        Text="当前“预计收入”按净利润口径展示，默认假设现有库存按预计售价全部售出。窗口支持拖拽边框缩放。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid
                    Grid.Row="1"
                    ColumnSpacing="16"
                    RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SoftInfoPanelStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="计算公式" />
                            <TextBlock Text="分类预计收入（净利润） = 当前库存 × (预计售价 - 收购单价)" TextWrapping="Wrap" />
                            <TextBlock Text="总预计收入（净利润） = Σ 各分类预计收入（净利润）" TextWrapping="Wrap" />
                            <TextBlock Text="等价写法 = 预计销售额 - 库存成本" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardSurfaceStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="口径说明" />
                            <TextBlock Text="预计销售额 = Σ(当前库存 × 预计售价)" TextWrapping="Wrap" />
                            <TextBlock Text="库存成本 = Σ(当前库存 × 收购单价)" TextWrapping="Wrap" />
                            <TextBlock Text="预计收入模块显示的是净利润，不再显示纯销售额。" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid
                    Grid.Row="2"
                    ColumnSpacing="16"
                    RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardSurfaceStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="预计销售额" />
                            <TextBlock Style="{StaticResource DetailMetricValueTextStyle}" Text="{x:Bind ProjectedSalesAmountText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardSurfaceStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="库存成本" />
                            <TextBlock Style="{StaticResource DetailMetricValueTextStyle}" Text="{x:Bind InventoryCostText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SoftWarmPanelStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="预计收入（净利润）" />
                            <TextBlock Style="{StaticResource DetailMetricValueTextStyle}" Foreground="{StaticResource BrandBrush}" Text="{x:Bind ProjectedNetProfitText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource CardSurfaceStyle}">
                    <TextBlock
                        Opacity="0.78"
                        Text="说明：当前口径暂不包含运输、人工、损耗等额外支出，主要用于帮助用户估算库存出售后的净利润。"
                        TextWrapping="Wrap" />
                </Border>
            </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Padding="24,16,24,24"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    MinWidth="180"
                    Click="OnCloseClick"
                    Content="关闭"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
